rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Allow anyone to read nurse data
    match /nurses/{document=**} {
      allow read: if true;

      // Only authenticated users (admins) can write/update
      allow create, update, delete: if request.auth != null && request.auth.token.email_verified;
    }

    // Configuration collection (admin only)
    match /config/{document=**} {
      allow read, write: if request.auth != null;
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
